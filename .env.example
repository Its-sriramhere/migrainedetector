# Vercel
VITE_API_URL=/api

# Backend
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./migraine.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# For PostgreSQL, e.g.:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/migraine

# Demo stream cadence
DEMO_INTERVAL_SECONDS=2.5

# --- SMS alerts (optional) ---
# SMS_ENABLED=true
# SMS_PROVIDER=mock          # "mock" logs to console/DB; "twilio" sends real SMS
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_FROM_NUMBER=+1XXXXXXXXXX   # a Twilio-owned number
# ALERT_SMS_TO=+1XXXXXXXXXX         # destination (verified in Twilio trial)
# ALERT_SMS_LEVEL=high              # "high" | "moderate" | "all"
# SMS_MAX_SENDS=5                   # hard cap on real SMS sends

# --- Supabase (fill the real DB password + service role key to switch the DB) ---
# SUPABASE_URL=https://lrulmcudqdlidhldncok.supabase.co
# SUPABASE_PROJECT_REF=lrulmcudqdlidhldncok
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=datasets

# --- Dataset / exports ---
# EXPORT_MAX_ROWS=10000
# DATASET_DIR=../ml/datasets
# THRESHOLDS_PATH=app/ml/thresholds.json