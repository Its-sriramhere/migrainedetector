{
  "framework": "vite",
  "regions": ["iad1"],
  "env": {
    "VITE_API_URL": "/api",
    "CORS_ORIGINS": "https://migraine-detector.vercel.app",
    "SMS_MAX_SENDS": "2",
    "SUPABASE_STORAGE_BUCKET": "datasets"
  },
  "builds": [
    { "src": "frontend/package.json", "use": "@vercel/node" },
    { "src": "backend/api.py", "use": "@vercel/python", "config": { "maxLambdaSize": "50mb" } }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/backend/api.py" },
    { "src": "/(.*)", "dest": "frontend/$1" }
  ]
}
