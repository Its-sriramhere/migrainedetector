# Migraine Detector backend — environment overrides.
# Copy to .env and adjust. Keep .env out of git (it holds secrets).

# --- Database ---
# DATABASE_URL=sqlite:///./migraine.db
# DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# --- Supabase (Storage + datasets metadata; app DB should be Supabase Postgres too) ---
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_PROJECT_REF=<ref>
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...   # server-only; never ship to the browser
# SUPABASE_STORAGE_BUCKET=datasets

# --- CORS (comma separated) ---
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- SMS alerts (REAL Twilio SMS is OFF until SMS_ENABLED=true) ---
SMS_ENABLED=false
SMS_PROVIDER=mock            # mock | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_SMS_TO=
ALERT_SMS_LEVEL=high         # high | moderate | all
SMS_MAX_SENDS=5              # hard cap on real sends

# --- Datasets / calibration override (usually not needed) ---
# DATASET_DIR=C:/Users/LOQ/Desktop/Migrainedetector/ml/datasets
# THRESHOLDS_PATH=C:/Users/LOQ/Desktop/Migrainedetector/backend/app/ml/thresholds.json

# Twilio provider requires: pip install twilio